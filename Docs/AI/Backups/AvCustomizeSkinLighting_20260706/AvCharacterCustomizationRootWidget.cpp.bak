	const FLinearColor CategoryInactiveText(0.58f, 0.60f, 0.62f, 1.f);
	const FLinearColor CategoryActiveIcon(0.95f, 0.42f, 0.04f, 1.f);
	const FLinearColor CategoryInactiveIcon(0.58f, 0.60f, 0.62f, 1.f);
	const FLinearColor SkinTones[] =
	{
		FLinearColor(0.98f, 0.82f, 0.68f, 1.f),
		FLinearColor(0.90f, 0.68f, 0.52f, 1.f),
		FLinearColor(0.76f, 0.52f, 0.36f, 1.f),
		FLinearColor(0.62f, 0.40f, 0.27f, 1.f),

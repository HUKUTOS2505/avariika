# Unreal Engine — генерируемое, не храним
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# IDE
.vs/
.vscode/
.idea/
*.sln
*.code-workspace

# Claudius runtime-мусор
Plugins/Claudius/Responses/
Plugins/Claudius/claudius_request.json
Plugins/Claudius/claudius_response.json
Claudius/Responses/
Claudius/claudius_request.json
Claudius/claudius_response.json

# Секреты — НЕ коммитить
.meshy_key

# Исходники моделей meshy (тяжёлые, регенерируются) — в git не держим
RawAssets/**/*.fbx
RawAssets/**/*.png
RawAssets/**/*.zip
RawAssets/**/*.glb
RawAssets/**/*.obj
RawAssets/**/*.jpg
RawAssets/**/*.jpeg
RawAssets/**/*.fbm/

# Python-кэш
Scripts/__pycache__/

# Локальные плагины-инструменты (Claudius/meshy) — тяжёлые, не игровой контент
Plugins/

# Временные отладочные скрипты (префикс _)
Scripts/_*.py

# Прочее
*.tmp
*.log

# UE content packs dumped into RawAssets (use the copy under Content/ instead)
RawAssets/**/*.uasset
RawAssets/**/*.umap
